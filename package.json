{
  "name": "grafana-thruk-datasource",
  "version": "2.3.0",
  "description": "grafana thruk datasource",
  "author": "Sven Nierlein",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "homepage": "https://github.com/sni/grafana-thruk-datasource#readme",
  "bugs": {
    "url": "https://github.com/sni/grafana-thruk-datasource/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sni/grafana-thruk-datasource.git"
  },
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix",
    "prettier:check": "prettier --list-different \"**/*.{ts,tsx,scss}\"",
    "prettier:write": "prettier --list-different \"**/*.{ts,tsx,scss}\" --write",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "yarn watch",
    "test": "jest",
    "test:watch": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.0.3",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "1.3.75",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.2.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^18.15.11",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^13.0.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@grafana/data": "^11.6.0",
    "@grafana/runtime": "^11.6.0",
    "@grafana/ui": "^11.6.0",
    "@hello-pangea/dnd": "^18.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "2.6.3"
  }
}
